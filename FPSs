local function drawGengarFace(parent, w, _h, anchor, pos)
	local cols, nrows = #GENGAR_ROWS[1], #GENGAR_ROWS
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.AnchorPoint = anchor
	f.Position = pos
	f.Size = UDim2.fromOffset(w, math.floor(w * nrows / cols + 0.5))
	f.Parent = parent
	local colors = {
		["#"] = Color3.fromRGB(8, 4, 14),
		["e"] = Color3.fromRGB(120, 72, 185),
		["o"] = Color3.fromRGB(250, 250, 250),
	}
	for y, row in ipairs(GENGAR_ROWS) do
		local x = 1
		while x <= cols do
			local c = row:sub(x, x)
			if c ~= "." then
				local x2 = x
				while x2 < cols and row:sub(x2 + 1, x2 + 1) == c do x2 = x2 + 1 end
				local b = Instance.new("Frame")
				b.BorderSizePixel = 0
				b.BackgroundColor3 = colors[c]
				b.Position = UDim2.new((x - 1) / cols, 0, (y - 1) / nrows, 0)
				b.Size = UDim2.new((x2 - x + 1) / cols, 0, 1 / nrows, 1)
				b.ZIndex = c == "o" and 3 or 2
				b.Parent = f
				x = x2 + 1
			else
				x = x + 1
			end
		end
	end
	return f
end

local function build()
	local okHui, hui = pcall(function() return gethui and gethui() end)
	gui = Instance.new("ScreenGui")
	gui.Name = "GengarFpsUI"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 998
	gui.Parent = (okHui and hui) or lp:WaitForChild("PlayerGui")

	local pill = Instance.new("Frame")
	pill.Size = UDim2.new(0, 150, 0, 28)
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position = UDim2.new(0.5, 0, 0, 70)
	pill.BackgroundColor3 = BG
	pill.Parent = gui
	Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)
	local stroke = Instance.new("UIStroke", pill)
	stroke.Color = LINE
	stroke.Thickness = 1.5


	label = Instance.new("TextLabel")
	label.Position = UDim2.new(0, 0, 0, 0)
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 12
	label.TextColor3 = TXT
		label.Text = "FPS --  |  -- ms"
	label.Parent = pill

	if GENGAR_IMAGE ~= "" then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1; img.Image = GENGAR_IMAGE; img.ScaleType = Enum.ScaleType.Fit
		img.AnchorPoint = Vector2.new(0.5, 1); img.Position = UDim2.new(0.5, 0, 0, 3); img.Size = UDim2.fromOffset(96, 62)
		img.Parent = pill
	else
		drawGengarFace(pill, 90, 58, Vector2.new(0.5, 1), UDim2.new(0.5, 0, 0, 3))
	end

	local dragging, dragStart, startPos
	pill.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, input.Position, pill.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	dragConn = UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			pill.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
end

local function stop()
	alive = false
	if beatConn then beatConn:Disconnect() beatConn = nil end
	if dragConn then dragConn:Disconnect() dragConn = nil end
	if gui then gui:Destroy() gui, label = nil, nil end
end

local function set(on)
	if on then
		if gui then return end
		alive = true
		build()
		local frames, acc = 0, 0
		beatConn = RunService.Heartbeat:Connect(function(dt)
			frames = frames + 1
			acc = acc + dt
			if acc >= 0.5 and label then
				local ping = 0
				pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
				local fps = math.floor(frames / acc + 0.5)
				label.Text = string.format("FPS %d  |  %d ms", fps, math.floor(ping + 0.5))
				label.TextColor3 = fps < 30 and EYE or TXT
				frames, acc = 0, 0
			end
		end)
	else
		stop()
	end
end

env.GengarFpsCleanup = stop
return set
