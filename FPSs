local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Stats = game:GetService("Stats")
local lp = Players.LocalPlayer

local BG, LINE = Color3.fromRGB(22, 14, 34), Color3.fromRGB(110, 66, 170)
local TXT, EYE = Color3.fromRGB(236, 226, 255), Color3.fromRGB(230, 40, 72)

local env = getgenv and getgenv() or _G
if env.GengarFpsCleanup then pcall(env.GengarFpsCleanup) end

local gui, label, beatConn, dragConn, alive
local GENGAR_IMAGE = "" -- pega aqui el id de tu imagen, por ejemplo "rbxassetid://123456789" (PNG con fondo transparente)


local function drawGengarFace(parent, w, h, anchor, pos)
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.AnchorPoint = anchor
	f.Position = pos
	f.Size = UDim2.fromOffset(w, h)
	f.Parent = parent
	local function box(x, y, bw, bh, col, rot, z, corner)
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = UDim2.new(x, 0, y, 0)
		b.Size = UDim2.new(bw, 0, bh, 0)
		b.BackgroundColor3 = col
		b.BorderSizePixel = 0
		b.Rotation = rot or 0
		b.ZIndex = z or 2
		b.Parent = f
		if corner then local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(corner, 0); c.Parent = b end
		return b
	end
	local BLACK, WHITE, EDGE = Color3.fromRGB(14, 8, 22), Color3.fromRGB(250, 250, 250), Color3.fromRGB(110, 66, 170)
	local sq = h / w
	for _, x in ipairs({0.1, 0.9}) do
		local e = box(x, 0.2, 0.17, 0.17 / sq, BLACK, 45, 1)
		local s = Instance.new("UIStroke"); s.Color = EDGE; s.Thickness = 1; s.Parent = e
	end
	box(0.5, 0.1, 0.12, 0.12 / sq, BLACK, 45, 1)
	local head = box(0.5, 0.58, 0.96, 0.82, BLACK, 0, 2, 0.28)
	local hs = Instance.new("UIStroke"); hs.Color = EDGE; hs.Thickness = 1; hs.Parent = head
	for _, d in ipairs({{0.29, 14}, {0.71, -14}}) do
		box(d[1], 0.36, 0.28, 0.2, WHITE, d[2], 4, 0.3)
		box(d[1], 0.36, 0.03, 0.17, BLACK, 0, 5)
	end
	box(0.5, 0.74, 0.8, 0.3, WHITE, 0, 3, 0.25)
	for i = 1, 5 do box(0.1 + i * 0.133, 0.74, 0.012, 0.3, BLACK, 0, 4) end
	box(0.5, 0.74, 0.8, 0.03, BLACK, 0, 4)
	return f
end

local function build()
	local okHui, hui = pcall(function() return gethui and gethui() end)
	gui = Instance.new("ScreenGui")
	gui.Name = "GengarFpsUI"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 998
	gui.Parent = (okHui and hui) or lp:WaitForChild("PlayerGui")

	local pill = Instance.new("Frame")
	pill.Size = UDim2.new(0, 150, 0, 28)
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position = UDim2.new(0.5, 0, 0, 70)
	pill.BackgroundColor3 = BG
	pill.Parent = gui
	Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)
	local stroke = Instance.new("UIStroke", pill)
	stroke.Color = LINE
	stroke.Thickness = 1.5


	label = Instance.new("TextLabel")
	label.Position = UDim2.new(0, 0, 0, 0)
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 12
	label.TextColor3 = TXT
		label.Text = "FPS --  |  -- ms"
	label.Parent = pill

	if GENGAR_IMAGE ~= "" then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1; img.Image = GENGAR_IMAGE; img.ScaleType = Enum.ScaleType.Fit
		img.AnchorPoint = Vector2.new(0.5, 1); img.Position = UDim2.new(0.5, 0, 0, 3); img.Size = UDim2.fromOffset(96, 62)
		img.Parent = pill
	else
		drawGengarFace(pill, 90, 58, Vector2.new(0.5, 1), UDim2.new(0.5, 0, 0, 3))
	end

	local dragging, dragStart, startPos
	pill.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, input.Position, pill.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	dragConn = UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			pill.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
end

local function stop()
	alive = false
	if beatConn then beatConn:Disconnect() beatConn = nil end
	if dragConn then dragConn:Disconnect() dragConn = nil end
	if gui then gui:Destroy() gui, label = nil, nil end
end

local function set(on)
	if on then
		if gui then return end
		alive = true
		build()
		local frames, acc = 0, 0
		beatConn = RunService.Heartbeat:Connect(function(dt)
			frames = frames + 1
			acc = acc + dt
			if acc >= 0.5 and label then
				local ping = 0
				pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
				local fps = math.floor(frames / acc + 0.5)
				label.Text = string.format("FPS %d  |  %d ms", fps, math.floor(ping + 0.5))
				label.TextColor3 = fps < 30 and EYE or TXT
				frames, acc = 0, 0
			end
		end)
	else
		stop()
	end
end

env.GengarFpsCleanup = stop
return set
